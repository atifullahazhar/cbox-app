generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  DEVELOPER
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DENIED
  CANCELED
}

enum PostAudience {
  FRIENDS_ONLY
  PUBLIC
  CLOSE_FRIENDS
}

enum MediaPurpose {
  AVATAR
  BANNER
  POST_IMAGE
  CHAT_IMAGE
  CHAT_AUDIO
  STORY_IMAGE
  CHAT_VIDEO
  PROFILE_AUDIO
}

enum MessageDeliveryState {
  SENT
  DELIVERED
  READ
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET_PASSWORD
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum GroupRole {
  OWNER
  ADMIN
  VICE_ADMIN
  MEMBER
}

enum ChatRequestStatus {
  PENDING
  ACCEPTED
  DENIED
}

enum CommunityChannelType {
  TEXT
  VOICE
}

enum EventRsvpStatus {
  GOING
  INTERESTED
}

model User {
  id                  String          @id @default(cuid())
  usernameNormalized  String          @unique @db.VarChar(24)
  usernameDisplay     String          @db.VarChar(24)
  phoneNormalized     String?         @unique @db.VarChar(20)
  phoneVerifiedAt     DateTime?
  signupDeviceHash    String?         @unique @db.VarChar(64)
  passwordHash        String
  secretPinHash       String?
  totpSecret          String?
  totpEnabled         Boolean         @default(false)
  primaryNickname     String          @db.VarChar(48)
  alternateNicknames  String[]        @default([])
  dateOfBirth         DateTime?
  isPrivateProfile    Boolean         @default(false)
  bio                 String          @default("") @db.VarChar(280)
  avatarMediaId       String?
  bannerMediaId       String?
  theme               ThemePreference @default(DARK)
  themeKey            String          @default("midnight-neon") @db.VarChar(32)
  hideOnlineStatus    Boolean         @default(false)
  disableReadReceipts Boolean         @default(false)
  role                UserRole        @default(USER)
  isSuspended         Boolean         @default(false)
  isVerified          Boolean         @default(false)
  customFlair         String          @default("") @db.VarChar(32)
  avatarFrame         String          @default("none") @db.VarChar(32)
  profileEffect       String          @default("none") @db.VarChar(32)
  customStatusEmoji   String          @default("") @db.VarChar(16)
  customStatusText    String          @default("") @db.VarChar(80)
  profileMusicTitle   String          @default("") @db.VarChar(80)
  profileMusicArtist  String          @default("") @db.VarChar(64)
  profileMusicPreset  String          @default("") @db.VarChar(32)
  profileMusicMediaId String?
  bioLinks            Json?
  interestTags        String[]        @default([])
  showProfileViews    Boolean         @default(true)
  isDemo              Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  avatarMedia         MediaAsset?        @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  bannerMedia         MediaAsset?        @relation("UserBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)

  sessions            Session[]
  uploadedMedia       MediaAsset[]       @relation("UploadedMedia")
  sentRequests        FriendRequest[]    @relation("SentFriendRequests")
  receivedRequests    FriendRequest[]    @relation("ReceivedFriendRequests")
  friendshipsA        Friendship[]       @relation("FriendshipUserA")
  friendshipsB        Friendship[]       @relation("FriendshipUserB")
  blocksInitiated     Block[]            @relation("BlocksInitiated")
  blocksReceived      Block[]            @relation("BlocksReceived")
  conversationsA      Conversation[]     @relation("ConversationUserA")
  conversationsB      Conversation[]     @relation("ConversationUserB")
  messagesSent        Message[]          @relation("MessagesSent")
  messageReactions    MessageReaction[]  @relation("UserMessageReactions")
  posts               Post[]             @relation("UserPosts")
  postLikes           PostLike[]         @relation("UserPostLikes")
  postComments        PostComment[]      @relation("UserPostComments")
  stories             Story[]            @relation("UserStories")
  storyViews          StoryView[]        @relation("UserStoryViews")
  groupsCreated       Group[]            @relation("GroupsCreated")
  groupMemberships    GroupMember[]      @relation("UserGroupMemberships")
  groupMessages       GroupMessage[]     @relation("UserGroupMessages")
  groupPollsCreated   GroupPoll[]        @relation("UserGroupPolls")
  groupPollVotes      GroupPollVote[]    @relation("UserGroupPollVotes")
  eventsCreated       Event[]            @relation("UserEventsCreated")
  eventRsvps          EventRsvp[]        @relation("UserEventRsvps")
  reportsFiled        SafetyReport[]     @relation("ReportsFiled")
  reportsReceived     SafetyReport[]     @relation("ReportsReceived")
  pushSubscriptions   PushSubscription[] @relation("UserPushSubscriptions")
  auditEvents         AuditEvent[]       @relation("UserAuditEvents")
  sentChatRequests    ChatRequest[]      @relation("ChatReqSender")
  receivedChatRequests ChatRequest[]     @relation("ChatReqReceiver")
  communitiesCreated  Community[]        @relation("CommunityCreator")
  communityMemberships CommunityMember[] @relation("UserCommunityMemberships")
  communityMessages   CommunityMessage[] @relation("UserCommunityMessages")
  storyHighlights     StoryHighlight[]   @relation("UserStoryHighlights")
  profileViewsReceived ProfileView[]     @relation("ProfileViewsReceived")
  profileViewsMade    ProfileView[]      @relation("ProfileViewsMade")
  closeFriends        CloseFriend[]      @relation("UserCloseFriends")
  closeFriendOf       CloseFriend[]      @relation("UserCloseFriendOf")
  moderationPrefsOwned UserModerationPref[] @relation("UserModPrefsOwned")
  moderationPrefsTarget UserModerationPref[] @relation("UserModPrefsTarget")

  @@index([usernameNormalized])
  @@index([phoneNormalized])
}

model Event {
  id          String      @id @default(cuid())
  creatorId   String
  title       String      @db.VarChar(100)
  category    String      @default("Meetup") @db.VarChar(32)
  description String      @default("") @db.VarChar(600)
  location    String      @default("Online on Chatterbox") @db.VarChar(120)
  startsAt    DateTime
  bgGradient  String      @default("from-sky-600 to-indigo-900") @db.VarChar(80)
  createdAt   DateTime    @default(now())

  creator     User        @relation("UserEventsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps       EventRsvp[]

  @@index([startsAt])
}

model EventRsvp {
  id        String          @id @default(cuid())
  eventId   String
  userId    String
  status    EventRsvpStatus @default(GOING)
  createdAt DateTime        @default(now())

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User            @relation("UserEventRsvps", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

model OtpChallenge {
  id              String     @id @default(cuid())
  phoneNormalized String     @db.VarChar(20)
  purpose         OtpPurpose
  codeHash        String
  attempts        Int        @default(0)
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime   @default(now())

  @@index([phoneNormalized, purpose, createdAt])
}

model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  csrfToken    String
  userId       String
  userAgent    String    @default("") @db.VarChar(256)
  ipAddress    String    @default("") @db.VarChar(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model MediaAsset {
  id          String       @id @default(cuid())
  ownerId     String
  purpose     MediaPurpose
  storageKey  String       @unique
  mimeType    String       @db.VarChar(64)
  byteSize    Int
  width       Int?
  height      Int?
  fileData    Bytes?
  createdAt   DateTime     @default(now())

  owner       User         @relation("UploadedMedia", fields: [ownerId], references: [id], onDelete: Cascade)
  avatarUsers User[]       @relation("UserAvatar")
  bannerUsers User[]       @relation("UserBanner")
  post        Post?
  message     Message?
  story       Story?

  @@index([ownerId, purpose])
}

model FriendRequest {
  id          String              @id @default(cuid())
  senderId    String
  receiverId  String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  sender      User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, status])
  @@index([receiverId, status])
  @@index([senderId, receiverId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA     User     @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Conversation {
  id                    String    @id @default(cuid())
  userAId               String
  userBId               String
  hiddenByA             Boolean   @default(false)
  hiddenByB             Boolean   @default(false)
  disappearAfterSeconds Int       @default(0)
  wallpaper             String    @default("default") @db.VarChar(32)
  lastMessageAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userA                 User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB                 User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages              Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model Message {
  id             String               @id @default(cuid())
  conversationId String
  senderId       String
  clientTempId   String?              @db.VarChar(64)
  content        String               @db.VarChar(2000)
  mediaId        String?              @unique
  mediaKind      String?              @db.VarChar(16)
  replyToId      String?
  deliveryState  MessageDeliveryState @default(SENT)
  expiresAt      DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())

  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                 @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  media          MediaAsset?          @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  replyTo        Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]            @relation("MessageReplies")
  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([expiresAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation("UserMessageReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Group {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(64)
  description String         @default("") @db.VarChar(240)
  inviteCode  String         @unique @db.VarChar(24)
  creatorId   String
  wallpaper   String         @default("default") @db.VarChar(32)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  creator     User           @relation("GroupsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  messages    GroupMessage[]
  polls       GroupPoll[]

  @@index([inviteCode])
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation("UserGroupMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  content   String   @db.VarChar(2000)
  mediaId   String?
  mediaKind String?  @db.VarChar(16)
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User     @relation("UserGroupMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model GroupPoll {
  id        String          @id @default(cuid())
  groupId   String
  creatorId String
  question  String          @db.VarChar(240)
  options   String[]
  createdAt DateTime        @default(now())

  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator   User            @relation("UserGroupPolls", fields: [creatorId], references: [id], onDelete: Cascade)
  votes     GroupPollVote[]

  @@index([groupId, createdAt])
}

model GroupPollVote {
  id          String    @id @default(cuid())
  pollId      String
  userId      String
  optionIndex Int
  createdAt   DateTime  @default(now())

  poll        GroupPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user        User      @relation("UserGroupPollVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
}

model Post {
  id           String         @id @default(cuid())
  authorId     String
  mediaId      String         @unique
  caption      String         @default("") @db.VarChar(1000)
  audience     PostAudience   @default(FRIENDS_ONLY)
  isPinned     Boolean        @default(false)
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  author       User           @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  media        MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  likes        PostLike[]
  comments     PostComment[]
  reports      SafetyReport[] @relation("PostReports")

  @@index([authorId, deletedAt, createdAt])
  @@index([audience, deletedAt, createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("UserPostLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  content   String    @db.VarChar(600)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation("UserPostComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, deletedAt, createdAt])
}

model Story {
  id           String       @id @default(cuid())
  authorId     String
  mediaId      String?      @unique
  textContent  String       @default("") @db.VarChar(280)
  bgGradient   String       @default("from-sky-600 to-indigo-900") @db.VarChar(80)
  audience     PostAudience @default(FRIENDS_ONLY)
  expiresAt    DateTime
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())

  author       User         @relation("UserStories", fields: [authorId], references: [id], onDelete: Cascade)
  media        MediaAsset?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  views        StoryView[]

  @@index([authorId, expiresAt, deletedAt])
  @@index([audience, expiresAt, deletedAt])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  viewerId  String
  viewedAt  DateTime @default(now())

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation("UserStoryViews", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([storyId])
}

model SafetyReport {
  id           String       @id @default(cuid())
  reporterId   String
  targetUserId String?
  targetPostId String?
  reason       String       @db.VarChar(80)
  details      String       @default("") @db.VarChar(500)
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  reporter     User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser   User?        @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetPost   Post?        @relation("PostReports", fields: [targetPostId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  action    String   @db.VarChar(80)
  outcome   String   @db.VarChar(24)
  ipAddress String   @default("") @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now())

  actor     User?    @relation("UserAuditEvents", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}


model ChatRequest {
  id         String            @id @default(cuid())
  senderId   String
  receiverId String
  status     ChatRequestStatus @default(PENDING)
  deniedAt   DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  sender     User              @relation("ChatReqSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User              @relation("ChatReqReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Community {
  id             String             @id @default(cuid())
  name           String             @db.VarChar(64)
  description    String             @default("") @db.VarChar(300)
  iconEmoji      String             @default("🌐") @db.VarChar(16)
  bannerGradient String             @default("from-sky-600 to-indigo-900") @db.VarChar(64)
  isPublic       Boolean            @default(true)
  inviteCode     String             @unique @db.VarChar(24)
  creatorId      String
  createdAt      DateTime           @default(now())

  creator        User               @relation("CommunityCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  channels       CommunityChannel[]
  members        CommunityMember[]
}

model CommunityChannel {
  id                 String               @id @default(cuid())
  communityId        String
  name               String               @db.VarChar(40)
  type               CommunityChannelType @default(TEXT)
  topic              String               @default("") @db.VarChar(160)
  readonlyForMembers Boolean              @default(false)
  slowModeSeconds    Int                  @default(0)
  position           Int                  @default(0)
  createdAt          DateTime             @default(now())

  community          Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages           CommunityMessage[]

  @@index([communityId, position])
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  role        GroupRole @default(MEMBER)
  joinedAt    DateTime  @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation("UserCommunityMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
}

model CommunityMessage {
  id        String           @id @default(cuid())
  channelId String
  senderId  String
  content   String           @default("") @db.VarChar(2000)
  mediaId   String?
  mediaKind String?          @db.VarChar(16)
  isPinned  Boolean          @default(false)
  createdAt DateTime         @default(now())

  channel   CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender    User             @relation("UserCommunityMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}


model StoryHighlight {
  id         String   @id @default(cuid())
  userId     String
  title      String   @db.VarChar(32)
  coverEmoji String   @default("✨") @db.VarChar(16)
  storyIds   String[] @default([])
  createdAt  DateTime @default(now())

  user       User     @relation("UserStoryHighlights", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ProfileView {
  id            String   @id @default(cuid())
  profileUserId String
  viewerId      String
  viewedAt      DateTime @default(now())

  profileUser   User     @relation("ProfileViewsReceived", fields: [profileUserId], references: [id], onDelete: Cascade)
  viewer        User     @relation("ProfileViewsMade", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([profileUserId, viewerId])
  @@index([profileUserId, viewedAt])
}

model CloseFriend {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user      User     @relation("UserCloseFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("UserCloseFriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model UserModerationPref {
  id           String   @id @default(cuid())
  ownerId      String
  targetId     String
  isMuted      Boolean  @default(false)
  isRestricted Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  owner        User     @relation("UserModPrefsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  target       User     @relation("UserModPrefsTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([ownerId, targetId])
  @@index([ownerId])
}
