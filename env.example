# =============================================================================
# CHATTERBOX ENVIRONMENT CONFIGURATION (.env.example)
# NEVER commit real secrets or API keys to GitHub.
# =============================================================================

NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
SERVE_FRONTEND=false
TRUST_PROXY=false

# PostgreSQL Database
DATABASE_URL=postgresql://cbox_user:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/cbox?schema=public

# Session & Internal Python Auth Security
SESSION_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
INTERNAL_AUTH_KEY=REPLACE_WITH_RANDOM_INTERNAL_AUTH_KEY
PYTHON_AUTH_URL=http://127.0.0.1:8001
COOKIE_SECURE=false

# SMS OTP Provider (Python Auth Engine)
# Options: "demo" (local/testing only) | "twilio" | "msg91"
SMS_PROVIDER=demo
OTP_DEMO_MODE=true

# Required when SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_TOKEN
TWILIO_FROM_NUMBER=+1REPLACE_WITH_TWILIO_NUMBER

# Required when SMS_PROVIDER=msg91 (popular for India SMS OTP)
MSG91_AUTH_KEY=REPLACE_WITH_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=REPLACE_WITH_MSG91_TEMPLATE_ID

# Optional Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=

# Developer Control Access Code (Server-Side Only — 6 to 32 alphanumeric chars)
DEVELOPER_ACCESS_CODE=REPLACE_WITH_8_CHAR_DEVELOPER_CODE
ALLOW_BLOCKING_DEVELOPERS=false

# Private Media Storage ("local" | "s3")
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./private_uploads
MAX_UPLOAD_MB=8
S3_ENDPOINT=https://REPLACE_WITH_S3_OR_R2_ENDPOINT
S3_REGION=auto
S3_BUCKET=chatterbox-private-media
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
